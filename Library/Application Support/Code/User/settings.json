{
  // #: Files
  "files.associations": {
    "*.kbd": "clojure",
    "*.fish": "shellscript",
    "*.plist": "xml",
    ".env": "properties",
    ".env.*": "properties",
    ".tool-versions": "properties",
    ".dockerignore": "ignore",
    "turbo.json": "jsonc",
  },
  "files.autoSave": "onFocusChange",
  "files.autoSaveWhenNoErrors": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // #: Workbench
  "window.openFilesInNewWindow": "on",
  "window.openFoldersInNewWindow": "on",
  "workbench.editor.closeEmptyGroups": false,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.labelFormat": "long",
  "workbench.editor.showTabs": "single",
  "workbench.editor.tabSizing": "shrink",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.tree.indent": 18,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.tree.enableStickyScroll": true,
  "workbench.iconTheme": null,
  "workbench.colorTheme": "Alabaster",
  "workbench.editor.empty.hint": "hidden",
  "workbench.activityBar.location": "top",
  // #: Editor
  "editor.cursorWidth": 2,
  "editor.cursorSurroundingLines": 10,
  "editor.smoothScrolling": true,
  "editor.find.addExtraSpaceOnTop": false,
  "editor.fontFamily": "'Iosevka Nerd Font', 'Fira Code', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "editor.fontSize": 13,
  "editor.lineHeight": 20,
  "editor.fontLigatures": true,
  "editor.showFoldingControls": "always",
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.minimap.maxColumn": 80,
  "editor.minimap.renderCharacters": false,
  "editor.renderControlCharacters": true,
  "editor.renderLineHighlight": "all",
  "editor.rulers": [80, 100, 120],
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestionsDelay": 3000,
  // https://code.visualstudio.com/docs/editor/intellisense#_settings
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.wordBasedSuggestions": "off",
  "editor.suggest.localityBonus": true,
  "editor.tabSize": 2,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.semanticTokenColorCustomizations": {
    "[Default Light+ Experimental]": {
      "rules": {
        "variable.readonly": {
          "italic": true,
        },
        "variable.local": {
          "italic": false,
        },
      },
    },
  },
  "editor.tokenColorCustomizations": {
    "[Alabaster]": {
      "textMateRules": [
        {
          "scope": "meta.template.expression",
          "settings": {
            "foreground": "#000",
          },
        },
      ],
    },
  },
  "editor.parameterHints.cycle": false,
  "editor.parameterHints.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.stickyScroll.enabled": true,
  "editor.guides.bracketPairs": "active",
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  // #: Sidebar: Explorer
  "explorer.openEditors.visible": 1,
  "explorer.confirmDelete": false,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.autoReveal": false,
  // #: Sidebar: Debug
  "debug.openDebug": "openOnDebugBreak",
  "debug.showInStatusBar": "always",
  "debug.toolBarLocation": "docked",
  "debug.console.wordWrap": false,
  // #: Sidebar: Extensions
  "extensions.ignoreRecommendations": true,
  // #: Panel: Terminal
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.lineHeight": 1,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.tabs.hideCondition": "never",
  "terminal.integrated.tabs.showActions": "always",
  "terminal.integrated.enablePersistentSessions": false,
  // #: Misc
  "task.allowAutomaticTasks": "off",
  "breadcrumbs.enabled": true,
  "search.smartCase": true,
  "notebook.formatOnSave.enabled": true,
  // #: Lang: Plain Text
  "[plaintext]": {
    "editor.rulers": [],
    "editor.wordWrap": "on",
  },
  // #: Lang: Markdown
  "[markdown]": {
    "editor.rulers": [],
    "editor.wordWrap": "on",
  },
  // #: Lang: HTML
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // #: Lang CSS
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // #: Lang: Javascript
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.format.enable": false,
  // #: Lang: Typescript
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.format.enable": false,
  // #: Lang: Svelte
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
  "svelte.enable-ts-plugin": true,
  "svelte.plugin.svelte.defaultScriptLanguage": "ts",
  // #: Lang: JSON
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // #: Lang: YAML
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // #: Lang: Docker
  "[dockerfile]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // #: Lang: Python
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
  // #: Lang: Clojure
  "[clojure]": {
    "editor.defaultFormatter": "betterthantomorrow.calva",
  },
  // #: Lang: Lua
  "[lua]": {
    "editor.defaultFormatter": "Koihik.vscode-lua-format",
  },
  // #: Lang: Shellscript
  "[shellscript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // #: Extension: GitLens
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.views.remotes.files.layout": "tree",
  // #: Extension: Eslint
  "eslint.lintTask.enable": true,
  // #: Extension: Tailwind
  "tailwindCSS.colorDecorators": false,
  // #: Extension: Live Share
  "liveshare.presence": true,
  "liveshare.allowGuestTaskControl": true,
  "liveshare.languages.allowGuestCommandControl": true,
  "liveshare.allowGuestDebugControl": true,
  // #: Extension: Highlight
  // https://github.com/fabiospampinato/vscode-highlight
  // https://code.visualstudio.com/api/references/vscode-api#DecorationRenderOptions
  "highlight.regexFlags": "gm",
  "highlight.regexes": {
    "([^\\w])((?:TODO):)": {
      "filterFileRegex": ".*(?<!CHANGELOG.md)$",
      "decorations": [
        {},
        {
          "overviewRulerColor": "#fbbf24",
          "backgroundColor": "#fbbf24",
          "borderRadius": "2px",
          "color": "#1f1f1f",
          "fontWeight": "bold",
        },
      ],
    },
    "([^\\w])((?:FIXME|FIX|BUG|HACK|WARN|UGLY|DEBUG|ISSUE):)": {
      "filterFileRegex": ".*(?<!CHANGELOG.md)$",
      "decorations": [
        {},
        {
          "overviewRulerColor": "#f87171",
          "backgroundColor": "#f87171",
          "color": "#1f1f1f",
          "fontWeight": "bold",
        },
      ],
    },
    "([^\\w])((?:IDEA|NOTE|REFS):)": {
      "filterFileRegex": ".*(?<!CHANGELOG.md)$",
      "decorations": [
        {},
        {
          "overviewRulerColor": "#4ade80",
          "backgroundColor": "#4ade80",
          "borderRadius": "2px",
          "color": "#1f1f1f",
          "fontWeight": "bold",
        },
      ],
    },
    "(?<=^|\\s)(#:)": {
      "decorations": [
        {
          "isWholeLine": true,
          "fontWeight": "900",
          "borderStyle": "solid",
          "borderWidth": "2px 0 0 0",
          "light": {
            "overviewRulerColor": "#d4d4d4", // Tailwind Neutral 300
            "borderColor": "#d4d4d4",
          },
          "dark": {
            "overviewRulerColor": "#525252", // Tailwind Neutral 600
            "borderColor": "#525252",
          },
        },
      ],
    },
    "(?<=^|\\s)(##:)": {
      "decorations": [
        {
          "isWholeLine": true,
          "borderStyle": "dashed",
          "borderWidth": "1px 0 0 0",
          "light": {
            "overviewRulerColor": "#d4d4d4", // Tailwind Neutral 300
            "borderColor": "#d4d4d4",
          },
          "dark": {
            "overviewRulerColor": "#525252", // Tailwind Neutral 600
            "borderColor": "#525252",
          },
        },
      ],
    },
  },
  // #: Extension: Playwright
  "playwright.reuseBrowser": true,
  // #: Extension: Claude Code
  "claudeCode.preferredLocation": "sidebar",
  // #: Git
  "git.openRepositoryInParentFolders": "always",
  "remote.SSH.configFile": "/Users/giacomoran/.ssh/config",
  "remote.SSH.path": "/usr/bin/ssh",
  "remote.SSH.defaultShell": "/bin/bash",
  "remote.SSH.remotePlatform": {
    "zeta": "linux",
    "filipporan-pc": "linux"
  },
}
