layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="~" focus=true {
        pane cwd="/Users/giacomoran"
    }
    tab name="rember-root" {
        pane cwd="/Users/giacomoran/Projects/rember-root"
    }
    tab name="rember" {
        pane cwd="/Users/giacomoran/Projects/rember-root/rember"
    }
    tab name="rember/" {
        pane cwd="/Users/giacomoran/Projects/rember-root/rember/packages/app-web"
    }
    tab name="rember-community" {
        pane cwd="/Users/giacomoran/Projects/rember-root/rember-community"
    }
    tab name="rember-community/" {
        pane cwd="/Users/giacomoran/Projects/rember-root/rember-community/packages/remb"
    }
}

